SECRET_KEY=change-me-in-production-use-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
POSTGRES_DB=marketplace
POSTGRES_USER=marketuser
POSTGRES_PASSWORD=marketpass
DATABASE_URL=postgresql://marketuser:marketpass@postgres:5432/marketplace

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Media Storage (MinIO / S3)
USE_S3=False
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=marketplace-media
AWS_STORAGE_BUCKET_NAME=marketplace-media
AWS_S3_REGION_NAME=us-east-1

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=

# Frontend URLs (for CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@androidmarket.com
